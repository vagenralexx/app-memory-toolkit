{
  "name": "app-memory-toolkit",
  "version": "1.0.0-rc.12",
  "description": "Memória de desenvolvimento e onboarding para projetos novos e existentes, via CLI e MCP.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "app-memory": "src/cli.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "EVALUATION.md",
    "INICIAR.cmd",
    "INICIAR.sh",
    "scripts",
    "test",
    "npm-shrinkwrap.json",
    "INSTALL.md",
    "AGENTS.md",
    "skills",
    "resources"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ignore": "7.0.13",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1",
    "neo4j-driver": "6.2.0",
    "node-sql-parser": "5.4.0",
    "pdfjs-dist": "6.4.299",
    "redis": "6.3.0",
    "tesseract.js": "7.0.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagenralexx/app-memory-toolkit.git"
  },
  "homepage": "https://github.com/vagenralexx/app-memory-toolkit#readme",
  "bugs": {
    "url": "https://github.com/vagenralexx/app-memory-toolkit/issues"
  }
}
